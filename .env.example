# Local credentials for FlyBrain. Copy to .env and fill in.
#
# .env is git-ignored and must never be committed. The token below is
# intentionally empty: FlyBrain never hardcodes a credential.
#
# A token is ONLY needed for neuPrint queries. Everything FlyBrain does with the
# local MaleCNS Feather files works with no token at all:
#   python scripts/analyze_mcns_top_edges.py --max-edges 1000000
#   python scripts/inspect_connectome.py --input <file>
#
# To get a token: sign in at https://neuprint.janelia.org/ and generate one from
# your account page. See
# https://connectome-neuprint.github.io/neuprint-python/docs/quickstart.html#client-and-authorization-token

NEUPRINT_TOKEN=
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0
